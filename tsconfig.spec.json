{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.spec.ts", "src/testing/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "platforms", "e2e"]
}
